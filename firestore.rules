rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }
    function isParticipant(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid));
    }
    function isOwner(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid;
    }

    match /rooms/{roomId} {
      // Any authenticated user may read the room doc — needed to retrieve passwordHash
      // before they become a participant (bootstrap requirement of the join flow).
      allow read: if isAuth();
      allow create: if isAuth()
                    && request.resource.data.createdBy == request.auth.uid;
      // Must already be a participant (or the owner) to update room fields, and
      // only `sessionEnded` may ever change. Without the field restriction any
      // participant could rewrite `createdBy` to make themselves host (gaining
      // kick and delete rights) or overwrite `passwordHash` to lock the room.
      allow update: if isAuth()
                    && (isParticipant(roomId) || resource.data.createdBy == request.auth.uid)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['sessionEnded']);
      allow delete: if isAuth()
                    && resource.data.createdBy == request.auth.uid;
    }

    match /rooms/{roomId}/participants/{userId} {
      // Read own doc, or read if already a participant (for the participants panel).
      allow read: if isAuth()
                  && (request.auth.uid == userId || isParticipant(roomId));
      // Only write your own participant doc.
      allow create, update: if isAuth() && request.auth.uid == userId;
      // Self-leave, or host kick.
      allow delete: if isAuth()
                    && (request.auth.uid == userId || isOwner(roomId));
    }

    match /rooms/{roomId}/messages/{msgId} {
      // Only participants can read or create messages. A message must be
      // attributed to its actual author, so one participant cannot post under
      // another's identity. The owner is exempt because kick notices are
      // written by the host on the kicked user's behalf.
      allow read:   if isAuth() && isParticipant(roomId);
      allow create: if isAuth() && isParticipant(roomId)
                    && (request.resource.data.senderId == request.auth.uid
                        || isOwner(roomId));
      // Own message: full update.
      // Other message: participants may only update translations/translationFailed
      // (needed for retroactive translation and retry flows).
      allow update: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        (isParticipant(roomId) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['translations', 'translationFailed']))
      );
      // Only the host may delete messages (room deletion flow).
      allow delete: if isAuth() && isOwner(roomId);
    }
  }
}
