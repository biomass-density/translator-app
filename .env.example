VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudflare Pages environment variables (set in dashboard, not in this file)
# GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key  (enable Cloud Translation API in Google Cloud Console)
# GOOGLE_TTS_API_KEY=your_google_cloud_api_key        (can be the same key if both APIs are enabled on the project)
